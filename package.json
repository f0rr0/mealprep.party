{
  "name": "our-kitchen",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "vercel:build": "bun scripts/vercel-build.ts",
    "start": "next start --hostname 127.0.0.1",
    "check": "next typegen && tsc --noEmit && bun scripts/check-content.ts",
    "validate": "bun run check && bun run lint && bun run format:check && bun run knip && bun run lint:commits",
    "lint:commits": "commitlint --from ${COMMITLINT_FROM:-HEAD~1} --to ${COMMITLINT_TO:-HEAD}",
    "test": "bun test",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "db:generate": "bun run --bun drizzle-kit generate",
    "db:migrate": "bun run --bun drizzle-kit migrate",
    "plan:sync": "bun scripts/sync-plan.ts",
    "lint:fix": "oxlint --deny-warnings --fix",
    "knip": "bun run --bun node_modules/knip/bin/knip.js",
    "commit": "cz"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "ios-haptics": "file:vendor/ios-haptics",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "next": "^16.3.6",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@shadcn/lint": "^0.2.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "knip": "^6.38.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2",
    "ultracite": "^7.12.1"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": "24.x"
  },
  "packageManager": "bun@1.4.2"
}
